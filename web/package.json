{
  "name": "skopje-statues-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "data": "python3 -I ../data/build_statues.py",
    "data:offline": "python3 -I ../data/build_statues.py --offline",
    "embed": "node scripts/embed-statues.mjs"
  },
  "dependencies": {
    "@fontsource/fira-sans": "^5.3.0",
    "@google/model-viewer": "^4.4.0",
    "@huggingface/transformers": "^4.3.1",
    "lucide-react": "^1.58.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
